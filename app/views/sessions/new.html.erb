<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-sm rounded-lg border border-gray-200 bg-white p-6">
  <h1 class="text-xl font-semibold">Sign in</h1>

  <%= form_with url: sign_in_otp_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email, class: "block text-sm font-medium" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
    </div>

    <%= form.submit "Send OTP", class: "w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-600">
    Don't have an account? <%= link_to "Sign up", sign_up_path, class: "font-medium text-indigo-600 hover:underline" %>
  </p>
</div>
