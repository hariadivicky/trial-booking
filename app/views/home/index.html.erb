<div class="flex items-center justify-between">
  <h1 class="text-2xl font-semibold">Book a trial class</h1>

  <% if current_user.is_a?(Admin) %>
    <%= button_to "Reset demo", demo_reset_path, form: { data: { turbo_confirm: "Delete all data and reload the seeds? You will be signed out." } },
      class: "rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700" %>
  <% end %>
</div>

<% @trial_classes_by_subject.each do |class_subject, trial_classes| %>
  <section class="mt-6">
    <h2 class="text-lg font-semibold"><%= class_subject.name %></h2>
    <ul class="mt-2 list-disc pl-5">
      <% trial_classes.each do |trial_class| %>
        <li>
          <% if current_user.is_a?(Admin) %>
            <%= link_to trial_class.title, roster_path(trial_class), class: "text-indigo-600 hover:underline" %>
            · <%= trial_class.fully_booked? ? "Fully booked" : "#{pluralize(trial_class.seats_left, "seat")} left" %>
          <% elsif trial_class.fully_booked? %>
            <span class="text-gray-500"><%= trial_class.title %> · Fully booked</span>
          <% else %>
            <%= link_to trial_class.title, checkout_path(trial_class), class: "text-indigo-600 hover:underline" %>
            · <%= pluralize(trial_class.seats_left, "seat") %> left
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
