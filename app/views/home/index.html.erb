<h1 class="text-2xl font-semibold">Book a trial class</h1>

<% @trial_classes_by_subject.each do |class_subject, trial_classes| %>
  <section class="mt-6">
    <h2 class="text-lg font-semibold"><%= class_subject.name %></h2>
    <ul class="mt-2 list-disc pl-5">
      <% trial_classes.each do |trial_class| %>
        <li>
          <% if trial_class.fully_booked? %>
            <span class="text-gray-500"><%= trial_class.title %> · Fully booked</span>
          <% else %>
            <%= link_to trial_class.title, checkout_path(trial_class), class: "text-indigo-600 hover:underline" %>
            · <%= pluralize(trial_class.seats_left, "seat") %> left
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
