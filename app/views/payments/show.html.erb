<% content_for :title, "Payment" %>

<div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6">
  <h1 class="text-xl font-semibold">Payment</h1>

  <p class="mt-4 rounded-md bg-amber-50 px-4 py-3 text-sm text-amber-800">
    Your seat is held for
    <time datetime="<%= @booking.expires_at.iso8601 %>" data-controller="countdown" class="font-semibold tabular-nums"><%= time_left(@booking.expires_at) %></time>
  </p>

  <%= form_with scope: :payment, url: payment_path(@booking), class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :card_number, "Card number", class: "block text-sm font-medium" %>
      <%= form.text_field :card_number, required: true, inputmode: "numeric", autocomplete: "cc-number", pattern: "[0-9]{16}", maxlength: 16, aria: { describedby: "card_number_hint" }, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
      <p id="card_number_hint" class="mt-1 text-sm text-gray-500">Use 4242424242424242.</p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :card_expiry, "Expiry", class: "block text-sm font-medium" %>
        <%= form.text_field :card_expiry, required: true, inputmode: "numeric", autocomplete: "cc-exp", pattern: "(0[1-9]|1[0-2])/[0-9]{2}", maxlength: 5, placeholder: "MM/YY", aria: { describedby: "card_expiry_hint" }, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
        <p id="card_expiry_hint" class="mt-1 text-sm text-gray-500">Any future month and year.</p>
      </div>

      <div>
        <%= form.label :card_cvv, "CVV", class: "block text-sm font-medium" %>
        <%= form.text_field :card_cvv, required: true, inputmode: "numeric", autocomplete: "cc-csc", pattern: "[0-9]{3}", maxlength: 3, placeholder: "123", aria: { describedby: "card_cvv_hint" }, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
        <p id="card_cvv_hint" class="mt-1 text-sm text-gray-500">Any 3 digits.</p>
      </div>
    </div>

    <%= form.submit "Pay now", class: "w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>
