<section class="mt-6">
  <h2 class="text-lg font-semibold"><%= title %></h2>

  <% if bookings.any? %>
    <table class="mt-2 w-full rounded-md bg-white text-left text-sm">
      <thead class="text-gray-500">
        <tr><th class="px-3 py-2">Child</th><th class="px-3 py-2">Parent</th><th class="px-3 py-2">Email</th></tr>
      </thead>
      <tbody>
        <% bookings.each do |booking| %>
          <tr class="border-t border-gray-200">
            <td class="px-3 py-2"><%= link_to booking.student.name, booking_payment_attempts_path(booking), class: "text-indigo-600 hover:underline" %></td>
            <td class="px-3 py-2"><%= booking.student.parent.name %></td>
            <td class="px-3 py-2"><%= booking.student.parent.email %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-2 text-sm text-gray-500"><%= empty_message %></p>
  <% end %>
</section>
