<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-sm rounded-lg border border-gray-200 bg-white p-6">
  <h1 class="text-xl font-semibold">Sign in</h1>

  <%= form_with url: sign_in_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email, class: "block text-sm font-medium" %>
      <%= form.email_field :email, value: @email, disabled: true, class: "mt-1 block w-full rounded-md border border-gray-300 bg-gray-100 px-3 py-2 text-gray-500" %>
    </div>

    <div>
      <%= form.label :otp, "OTP", class: "block text-sm font-medium" %>
      <%= form.text_field :otp, required: true, autofocus: true, inputmode: "numeric", autocomplete: "one-time-code", aria: { describedby: "otp_hint" }, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
      <p id="otp_hint" class="mt-1 text-sm text-gray-500">Use 1234 as the code.</p>
    </div>

    <%= form.submit "Sign In", class: "w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>
