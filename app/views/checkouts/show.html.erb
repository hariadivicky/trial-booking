<% content_for :title, "Checkout" %>

<div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6">
  <h1 class="text-xl font-semibold">Checkout</h1>

  <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 rounded-md bg-gray-50 px-4 py-3 text-sm">
    <dt class="text-gray-500">Class</dt>
    <dd class="font-medium"><%= @trial_class.title %></dd>
    <dt class="text-gray-500">Total</dt>
    <dd class="font-medium"><%= number_to_currency(@trial_class.price_cents / 100.0, unit: "SGD ") %></dd>
  </dl>

  <%= form_with url: checkout_path(@trial_class), class: "mt-6 space-y-6" do |form| %>
    <fieldset class="space-y-4">
      <legend class="font-semibold">About you</legend>

      <% if current_user %>
        <p class="text-sm">Booking as <span class="font-medium"><%= current_user.name %></span></p>
      <% else %>
        <%= fields :parent do |parent_form| %>
          <div>
            <%= parent_form.label :name, "Your name", class: "block text-sm font-medium" %>
            <%= parent_form.text_field :name, required: true, autocomplete: "name", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
          </div>

          <div>
            <%= parent_form.label :email, class: "block text-sm font-medium" %>
            <%= parent_form.email_field :email, required: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
          </div>
        <% end %>
      <% end %>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="font-semibold">Your child</legend>

      <%= fields :student do |student_form| %>
        <div>
          <%= student_form.label :name, "Child's name", class: "block text-sm font-medium" %>
          <%= student_form.text_field :name, required: true, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2" %>
        </div>
      <% end %>
    </fieldset>

    <%= form.submit "Book trial class", class: "w-full rounded-md bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-500" %>
  <% end %>
</div>
